# ==============================================================================
# Discord Configuration
# ==============================================================================
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_discord_movies_channel_id_here
DISCORD_SERIES_CHANNEL_ID=your_discord_series_channel_id_here

# ==============================================================================
# Radarr & Sonarr (Quality Profiles and Root Folders are configured
# automatically in Discord on first startup or via !setup)
# ==============================================================================
RADARR_URL=http://192.168.1.10:7878
RADARR_API_KEY=your_radarr_api_key_here

SONARR_URL=http://192.168.1.10:8989
SONARR_API_KEY=your_sonarr_api_key_here

# ==============================================================================
# TMDB & Schedules
# ==============================================================================
TMDB_API_KEY=your_tmdb_api_key_here
# OMDB_API_KEY=your_omdb_api_key_here  # Optional: For IMDb ratings (from omdbapi.com)
CRON_SCHEDULE=0 17 * * 5
CRON_SCHEDULE_SERIES=0 17 * * 5

